{
    "name": "family-meals-backend",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "start": "node dist/main.js",
        "start:dev": "ts-node-dev --respawn --transpile-only src/main.ts",
        "build": "tsc -p tsconfig.json",
        "lint": "eslint . --ext .ts",
        "format": "prettier --write \"src/**/*.ts\"",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage",
        "test:e2e": "jest --config ./test/jest-e2e.json",
        "typeorm": "ts-node ./node_modules/typeorm/cli",
        "migration:generate": "npm run typeorm -- migration:generate -d src/config/data-source.ts",
        "migration:create": "npm run typeorm -- migration:create",
        "migration:run": "npm run typeorm -- migration:run -d src/config/data-source.ts",
        "migration:revert": "npm run typeorm -- migration:revert -d src/config/data-source.ts",
        "seed": "ts-node src/database/seeds/initial-seed.ts",
        "seed:poems": "ts-node src/database/seeds/poems.seed.ts"
    },
    "dependencies": {
        "@nestjs/common": "^10.0.0",
        "@nestjs/config": "^3.0.0",
        "@nestjs/core": "^10.0.0",
        "@nestjs/jwt": "^10.0.0",
        "@nestjs/passport": "^10.0.0",
        "@nestjs/platform-express": "^10.0.0",
        "@nestjs/swagger": "^7.4.2",
        "@nestjs/throttler": "^6.4.0",
        "@nestjs/typeorm": "^11.0.0",
        "bcrypt": "^5.1.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.0",
        "dotenv": "^16.6.1",
        "helmet": "^8.1.0",
        "nest-winston": "^1.10.2",
        "passport": "^0.7.0",
        "passport-jwt": "^4.0.1",
        "pg": "^8.12.0",
        "reflect-metadata": "^0.1.13",
        "rxjs": "^7.8.0",
        "typeorm": "^0.3.12",
        "winston": "^3.18.3"
    },
    "devDependencies": {
        "@nestjs/testing": "^10.0.0",
        "@types/bcrypt": "^5.0.0",
        "@types/express": "^4.17.21",
        "@types/jest": "^29.5.0",
        "@types/node": "^20.0.0",
        "@types/passport-jwt": "^4.0.1",
        "@types/supertest": "^2.0.12",
        "@typescript-eslint/eslint-plugin": "^7.0.0",
        "@typescript-eslint/parser": "^7.0.0",
        "eslint": "^8.0.0",
        "eslint-config-prettier": "^9.0.0",
        "eslint-plugin-import": "^2.27.5",
        "jest": "^29.5.0",
        "prettier": "^3.0.0",
        "supertest": "^6.3.0",
        "ts-jest": "^29.1.0",
        "ts-node": "^10.9.1",
        "ts-node-dev": "^2.0.0",
        "typescript": "^5.4.0"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s$": "ts-jest"
        },
        "collectCoverageFrom": [
            "**/*.(t|j)s"
        ],
        "coverageDirectory": "../coverage",
        "testEnvironment": "node"
    }
}
